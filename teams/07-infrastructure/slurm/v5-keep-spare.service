# Controller only (ADR 0002 §1): name the hot spare and boot one if none is free. Run by v5-keep-spare.timer.
[Unit]
Description=V5 keep one free GPU node up (hot spare)
After=slurmctld.service

[Service]
Type=oneshot
User=slurm
Environment=V5_EVENTS_DIR=/var/log/v5/events
ExecStart=/opt/venv/bin/python /opt/v5/queue/job_queue.py keep-spare --partition gpu --spares 1
