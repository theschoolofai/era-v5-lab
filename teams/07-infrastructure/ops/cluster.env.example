# /etc/v5/cluster.env: what launch.sh needs to know about the cluster (no secrets here).
V5_DBD_HOST=ctl-1                       # runs slurmdbd (the accounting DB itself is RDS/MariaDB)
V5_CTLD_HOSTS="ctl-1 ctl-2"             # primary first, then the backup controller
V5_NODES="gpu-1 gpu-2 gpu-3"            # GPU nodes for the main run (2 + the hot spare)
V5_MIN_NODES=2                          # fewer healthy nodes than this: launch stops before submitting
V5_REMOTE_ROOT=s3://v5-ckpt/ckpt        # checkpoint store; the run lives at <root>/<RUN_ID>
RUN_ID=v5main
V5_BACKUP_DIR=/var/backups/slurm        # accounting DB dumps (synced to S3 by backup_db.sh's caller)
V5_EXEC="ssh -o BatchMode=yes -o ConnectTimeout=10 %h"
# V5_MAIN_ARGS="--nodes=2"              # extra sbatch arguments for the main run
# V5_MAIN_ENV="STEPS=100000,INTERVAL_S=1800"
