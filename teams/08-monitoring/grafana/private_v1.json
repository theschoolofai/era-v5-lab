    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "description": "dead_experts_count per optimizer step: routed experts, over all MoE layers, that got less than 0.1 x the uniform share (1 / number of experts) of their layer's picks in the step. 0 is healthy. A count that stays above 0 means the router has stopped using those experts. Worked out by metrics_writer.py from expert_load when the trainer does not log it.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "dead experts",
            "lineWidth": 2,
            "showPoints": "auto",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "step"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "step"
