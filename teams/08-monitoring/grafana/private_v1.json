          "queryType": "table",
          "rawSql": "SELECT step, concat(run_id, ' ', series) AS series, v AS value FROM (SELECT run_id, step, if(name = 'tokens_per_byte', 'all', replaceOne(name, 'tokens_per_byte_by_lang.', '')) AS series, value AS v FROM metrics_raw WHERE (name = 'tokens_per_byte' OR name LIKE 'tokens_per_byte_by_lang.%') AND run_id IN ($run) AND value IS NOT NULL UNION ALL SELECT run_id, step, 'all' AS series, sumIf(value, name = 'train/scored_tokens') / sumIf(value, name = 'train/utf8_bytes') AS v FROM metrics_raw WHERE name IN ('train/scored_tokens', 'train/utf8_bytes') AND run_id IN ($run) AND run_id NOT IN (SELECT DISTINCT run_id FROM metrics_raw WHERE name = 'tokens_per_byte' AND run_id IN ($run)) GROUP BY run_id, step HAVING sumIf(value, name = 'train/utf8_bytes') > 0) ORDER BY step, series",
