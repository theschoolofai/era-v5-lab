        "uid": "${ds}"
      },
      "description": "expert_utilization_min per optimizer step: the lowest utilization of any routed expert, where utilization is the expert's share of its layer's picks divided by the uniform share (1 / number of experts). 1.0 is a fair share. Below 0.1 the expert counts as dead, so this line falls before dead_experts_count rises: an early warning. Worked out by metrics_writer.py from expert_load.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "x fair share",
            "lineWidth": 2,
            "showPoints": "auto",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "transparent",
                "value": 0.5
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "step"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
