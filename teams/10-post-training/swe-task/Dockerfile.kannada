FROM python:3.12-slim
WORKDIR /team
ENV PYTHONDONTWRITEBYTECODE=1
COPY chat-format/render.py chat-format/
COPY swe-task/kannada_text_prep.py swe-task/run_kannada_e2e.py swe-task/kannada_examples.py swe-task/preview_kannada.py swe-task/
COPY tests/test_kannada_text_prep.py tests/
CMD ["python", "-B", "swe-task/run_kannada_e2e.py", "--output-dir", "/evidence"]
